# ----------------------------------------------------------------------------
# Frontend (exposed to the browser — safe to be public: anon key + URL only)
# Vite only exposes vars prefixed with VITE_ to client code.
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# ----------------------------------------------------------------------------
# Netlify Functions (server-side only — NEVER prefix these with VITE_)
# Set these in the Netlify UI (Site settings > Environment variables), not here.
# ----------------------------------------------------------------------------

# Supabase service-role key. Server-side only. Grants full DB access, bypasses
# RLS. Used by the search pipeline to write businesses/contacts/api_usage.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Same project URL as above, but without the VITE_ prefix for the functions.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Google Places API (New) key. Restrict it to the Places API in Google Cloud.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ZoomInfo API credentials (PKI/JWT auth). Ask the account owner for these.
# Enrichment is optional and non-blocking; leave blank to skip enrichment.
ZOOMINFO_USERNAME=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# Hard monthly cap per Google call type (default 4500 if unset).
MONTHLY_API_CAP=4500
